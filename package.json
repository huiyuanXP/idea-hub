{
  "name": "agent-task-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node --experimental-strip-types scripts/server.mjs --dev",
    "build": "node scripts/build.mjs",
    "start": "node --experimental-strip-types scripts/server.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test": "npm run build && npx --no-install tsc --noEmit && npm run lint && npm run test:app && npm run test:execution && npm run test:backend:integration && npm run test:execution:consumer:backend",
    "test:browser-policy": "node --test tests/browser/*.test.mjs",
    "test:execution": "node scripts/test-execution.mjs",
    "test:execution:api": "node --experimental-strip-types tests/execution/native-api.mjs",
    "test:workspaces": "node scripts/test-execution.mjs --workspaces",
    "test:auth": "node --experimental-strip-types --test tests/auth/*.test.mjs",
    "test:auth:api": "node --experimental-strip-types tests/auth/native-api.mjs",
    "test:auth:browser": "node --experimental-strip-types tests/auth/browser.mjs",
    "test:planning:revisions": "node --experimental-strip-types tests/planning/revisions.mjs",
    "test:execution:configuration": "node --experimental-strip-types tests/execution/mcp-configuration-native.mjs",
    "test:backend:integration": "node --experimental-strip-types tests/execution/backend-native.mjs",
    "test:planning:recovery": "node --experimental-strip-types tests/planning/recovery.mjs",
    "test:planning:lifecycle": "node --experimental-strip-types tests/planning/lifecycle.mjs",
    "test:planning:browser": "node --experimental-strip-types tests/planning/browser.mjs",
    "test:mcp:task-reads": "npm run test:mcp:task-read-bytes && node --experimental-strip-types tests/mcp/task-reads.mjs && npm run test:mcp:task-runs",
    "test:mcp:task-runs": "node --experimental-strip-types tests/mcp/task-run-reads.mjs",
    "accounts": "node --experimental-strip-types scripts/accounts.mjs",
    "test:local": "node --experimental-strip-types --test tests/local/*.test.mjs",
    "test:execution:domain": "node scripts/test-execution.mjs --domain",
    "test:authorization:browser": "node --experimental-strip-types tests/execution/authorization-native.mjs",
    "test:planning:review": "node --experimental-strip-types tests/planning/recovery-delivery-review.mjs",
    "test:app": "npm run test:unit && npm run test:connectors && npm run test:ticket-status:native && npm run test:workspace-loop && npm run test:local && npm run test:execution:domain && npm run test:execution:workers && npm run test:execution:consumer && npm run test:browser-policy && npm run test:auth && npm run test:auth:api && npm run test:execution:api && npm run test:mcp:task-reads && npm run test:planning:revisions && npm run test:execution:configuration && npm run test:planning:recovery && npm run test:planning:lifecycle && npm run test:planning:review && npm run test:planning:browser && npm run test:details:browser && npm run test:auth:browser && npm run test:authorization:browser && npm run test:integration",
    "package:connector": "node scripts/package-connector.mjs",
    "test:connectors": "node --experimental-strip-types --test tests/connectors/*.test.mjs tests/workspace-runs/*.test.mjs tests/connector-client/*.test.mjs",
    "test:ticket-status:native": "node --experimental-strip-types tests/connectors/ticket-status-native.mjs",
    "test:workspace-loop": "node --experimental-strip-types tests/workspace-loop.mjs",
    "test:next-steps": "node --experimental-strip-types tests/browser/next-steps.mjs",
    "test:details:browser": "node --experimental-strip-types tests/details/browser.mjs",
    "test:live-console:browser": "node --experimental-strip-types tests/details/live-console-browser.mjs",
    "test:mcp:task-read-bytes": "node --experimental-strip-types --test tests/task-reads/*.test.mjs && node --experimental-strip-types tests/mcp/task-read-bytes-native.mjs",
    "test:execution:workers": "node --experimental-strip-types --test --test-concurrency=1 tests/execution/workers.test.mjs tests/execution/worker-guard.test.mjs tests/execution/worker-leases.test.mjs tests/execution/worker-actions.test.mjs && node --experimental-strip-types tests/execution/worker-native.mjs && node --experimental-strip-types tests/execution/worker-leases-native.mjs",
    "execution:consume": "node --experimental-strip-types runner/consumer.mjs",
    "test:execution:consumer": "node --experimental-strip-types --test --test-concurrency=1 tests/execution/consumer-state.test.mjs tests/execution/consumer-transport.test.mjs && node --experimental-strip-types tests/execution/consumer-native.mjs",
    "test:execution:consumer:backend": "node --experimental-strip-types tests/execution/consumer-backend-native.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
